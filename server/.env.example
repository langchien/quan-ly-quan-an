PORT=4000
DOMAIN=localhost
PROTOCOL=http

# PostgreSQL connection string (kết nối container Docker PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/quan_ly_quan_an?schema=public"

ACCESS_TOKEN_SECRET=dev_access_token_secret_random_123456789
REFRESH_TOKEN_SECRET=dev_refresh_token_secret_random_123456789
GUEST_ACCESS_TOKEN_SECRET=dev_guest_access_token_secret_random_123456789
GUEST_REFRESH_TOKEN_SECRET=dev_guest_refresh_token_secret_random_123456789

# Thời gian hết hạn token
ACCESS_TOKEN_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=1d
GUEST_ACCESS_TOKEN_EXPIRES_IN=15m
GUEST_REFRESH_TOKEN_EXPIRES_IN=12h

UPLOAD_FOLDER=uploads
INITIAL_EMAIL_OWNER=admin@gmail.com
INITIAL_PASSWORD_OWNER=123456

