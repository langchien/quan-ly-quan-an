              "raw": "{{baseUrl}}/static/ten-file-anh.jpg",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "static",
                "ten-file-anh.jpg"
              ]
            }
          },
          "response": []
        }
      ],
      "description": "Upload ảnh. Cần đăng nhập."
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const skipPaths = ['/auth/login', '/auth/refresh-token', '/guest/auth/login', '/guest/auth/refresh-token'];",
          "const url = pm.request.url.toString();",
          "const isGuestReq = url.includes('/guest/orders');",
          "const needsOwnerAuth = !skipPaths.some(p => url.includes(p)) && !isGuestReq;",
          "if (needsOwnerAuth) {",
          "  const token = pm.environment.get('accessToken') || pm.collectionVariables.get('accessToken');",
          "  if (!token) {",
          "    const base = pm.environment.get('baseUrl') || 'http://localhost:4000';",
          "    pm.sendRequest({ url: base + '/auth/login', method: 'POST',",
          "      header: {'Content-Type': 'application/json'},",
          "      body: { mode: 'raw', raw: JSON.stringify({",
          "        email: pm.environment.get('ownerEmail') || 'admin@order.com',",
          "        password: pm.environment.get('ownerPassword') || '123456'",
          "      })}}, function(err, res) {",
          "      if (!err && res.json().data) {",
          "        const d = res.json().data;",
          "        pm.environment.set('accessToken', d.accessToken);",
          "        pm.environment.set('refreshToken', d.refreshToken);",
          "        pm.collectionVariables.set('accessToken', d.accessToken);",
          "        pm.collectionVariables.set('refreshToken', d.refreshToken);",
          "        console.log('✅ Auto-login OK! Role:', d.account.role);",
          "      } else { console.error('❌ Auto-login thất bại. Server có đang chạy?'); }",
          "    });",
          "  }",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const code = pm.response.code, t = pm.response.responseTime;",
          "if (code >= 200 && code < 300) { console.log(`✅ [${code}] ${pm.info.requestName} (${t}ms)`); }",
          "else if (code === 401) { console.warn('⚠️ 401 - Xóa token, sẽ tự login lại'); pm.environment.unset('accessToken'); pm.collectionVariables.unset('accessToken'); }",
          "else if (code === 403) { console.warn('⚠️ 403 - Cần quyền Owner'); }",
          "else { console.error(`❌ [${code}]`, pm.response.text().substring(0, 200)); }",
          "try {",
          "  const res = pm.response.json(); const url = pm.request.url.toString();",
          "  if (res && res.data && !Array.isArray(res.data)) {",
          "    if (res.data.id && url.includes('/dishes')) pm.environment.set('dishId', res.data.id);",
          "    if (res.data.number && url.includes('/tables')) { pm.environment.set('tableNumber', res.data.number); if (res.data.token) pm.environment.set('tableToken', res.data.token); }",
          "  }",
          "  if (res && res.data && Array.isArray(res.data) && res.data.length > 0) {",
          "    if (url.includes('/tables')) { pm.environment.set('tableNumber', res.data[0].number); pm.environment.set('tableToken', res.data[0].token); }",
          "    if (url.includes('/dishes')) pm.environment.set('dishId', res.data[0].id);",
          "    if (url.includes('/accounts') && !url.includes('/me') && !url.includes('/guests') && !url.includes('/password')) pm.environment.set('employeeId', res.data[0].id);",
          "    if (url.includes('/accounts/guests')) pm.environment.set('guestId', res.data[0].id);",
          "    if (url.includes('/orders')) { pm.environment.set('orderId', res.data[0].id); if (res.data[0].guestId) pm.environment.set('guestId', res.data[0].guestId); }",
          "  }",
          "} catch(e) {}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "guestAccessToken",
      "value": ""
    },
    {
      "key": "guestRefreshToken",
      "value": ""
    }
  ]
}